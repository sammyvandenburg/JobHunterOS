# Copy to .env only if you want to override defaults. Never commit .env.
# Where Hunter keeps private state (database, documents, exports). Default: ~/.jobhunteros
# JOBHUNTER_HOME=/home/you/.jobhunteros

# Dashboard bind address and port. Keep 127.0.0.1 unless you know what you are doing.
# JOBHUNTER_DASHBOARD_HOST=127.0.0.1
# JOBHUNTER_DASHBOARD_PORT=8765

# Secret storage backend: "auto" (OS keyring, then protected file), "keyring", or "file".
# JOBHUNTER_SECRETS_BACKEND=auto
# Optional passphrase that encrypts the file backend. Set it in the worker's environment too.
# JOBHUNTER_SECRETS_PASSPHRASE=

# Optional Adzuna keys (free developer account) to widen discovery. Leave unset to skip.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Optional direct Claude API key for unattended matching explanations. Leave unset to use
# the `claude` CLI login, or to run in rule-based mode.
# ANTHROPIC_API_KEY=
